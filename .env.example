# Copy to .env for local dev. On Vercel: Project → Settings → Environment Variables
# Add each name below (Production + Preview recommended).

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_BOOKING_TEMPLATE_ID=
VITE_EMAILJS_NEWSLETTER_TEMPLATE_ID=
# Optional: dedicated template for job applications (falls back to VITE_EMAILJS_TEMPLATE_ID)
VITE_EMAILJS_HIRING_TEMPLATE_ID=
VITE_SITE_URL=https://softtrickscode.com
